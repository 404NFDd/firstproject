generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 사용자 모델
model User {
  id               String     @id @default(cuid())
  email            String     @unique
  name             String?
  password         String
  adminUsername    String?    @unique
  isAdmin          Boolean    @default(false)
  image            String?
  emailSubscription Int       @default(0) // 0: 구독 안함, 1: 구독함
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  
  // 관계
  briefingDeliveries BriefingDelivery[]
  refreshTokens RefreshToken[]
  newsReadHistory NewsReadHistory[]
  
  @@index([email])
  @@index([emailSubscription])
}

// Refresh Token 저장소
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([userId])
}

// 뉴스 기사
model News {
  id            String   @id @default(cuid())
  title         String   @db.LongText
  description   String?  @db.LongText
  content       String?  @db.LongText
  imageUrl      String?  @db.Text
  sourceUrl     String?  @db.Text
  source        String
  author        String?
  publishedAt   DateTime
  category      String   @default("100")
  priority      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // 관계
  readHistory   NewsReadHistory[]
  summary       NewsSummary?
  translations  NewsTranslation[]
  
  @@index([category])
  @@index([publishedAt])
  @@index([createdAt])
}

// 뉴스 읽음 이력
model NewsReadHistory {
  id        String   @id @default(cuid())
  userId    String
  newsId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  readCount Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, newsId])
  @@index([userId])
  @@index([newsId])
}

// 뉴스 요약 저장
model NewsSummary {
  id        String   @id @default(cuid())
  newsId    String   @unique
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  summary   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([newsId])
  @@index([createdAt])
}

// 뉴스 동기화 로그
model NewsSyncLog {
  id        String   @id @default(cuid())
  status    String   @default("success") // success, failed, processing
  fetched   Int      @default(0)
  persisted Int      @default(0)
  skipped   Int      @default(0)
  error     String?  @db.Text
  createdCount Int @default(0)
  repairedCount Int @default(0)
  excludedCount Int @default(0)
  durationMs Int @default(0)
  sourceReports Json?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  
  @@index([createdAt])
  @@index([status, createdAt])
}

// 한국 날짜별 정기 브리핑 발송 상태. 테스트 메일은 이 기록에 포함하지 않습니다.
model BriefingDelivery {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey String @db.VarChar(10)
  status String @default("processing")
  attempts Int @default(1)
  startedAt DateTime @default(now())
  sentAt DateTime?
  messageId String? @db.Text
  error String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dateKey])
  @@index([dateKey, status])
}


// 한국어 요약 결과와 작업 예약을 저장합니다. 기존 테이블명을 재사용합니다.
model NewsTranslation {
  id String @id @default(cuid())
  newsId String
  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)
  kind String
  chunkIndex Int @default(0)
  sourceHash String @db.VarChar(64)
  status String @default("pending")
  translatedTitle String? @db.LongText
  translatedText String? @db.LongText
  startedAt DateTime?
  retryAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([newsId, kind, chunkIndex])
}

// 무료 프로젝트의 요약 요청을 집계합니다. 기존 사용량 기록을 보존합니다.
model NewsTranslationUsage {
  dateKey String @db.VarChar(10)
  model String @default("gemini-3.5-flash-lite") @db.VarChar(64)
  requests Int @default(0)
  nextRequestAt DateTime @default(now())
  blockedUntil DateTime?
  // 기본 모델의 날짜별 행에 현재 사용 모델을 저장합니다. 새 날짜에는 기본 모델에서 시작합니다.
  activeModel String? @db.VarChar(64)

  @@id([dateKey, model])
}
