# Prisma CLI와 Next.js가 함께 읽을 프로젝트 루트의 .env에 설정합니다.
DATABASE_URL="mysql://news_user:password@localhost:3306/news_db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
# 기본값: 액세스 15분, 갱신 7일 (양의 정수, 초 단위)
JWT_ACCESS_EXPIRES_IN="900"
JWT_REFRESH_EXPIRES_IN="604800"

# 자동 수집과 브리핑을 사용할 때 필수. 로그인 버튼 수집에는 필요하지 않습니다.
CRON_SECRET=""

# 선택: 비워두면 AI 요청 없이 기사 설명/제목을 사용합니다.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# AI_SUMMARY_PROMPT="다음 기사를 한국어로 간결하게 요약해주세요: {content}"

# 이메일 기능을 사용할 때 설정합니다.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NewsHub <noreply@example.com>"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# 관리자: 설정 후 npm run admin:sync로 DB에 해시 비밀번호를 저장합니다.
ADMIN_ID="admin"
ADMIN_PASSWORD=""
# 메일 수신이 필요하면 실제 관리자 이메일로 변경합니다.
ADMIN_EMAIL="admin@newshub.local"


# 사전 한국어 번역 워커: 비워두면 API를 호출하지 않고 큐를 보존합니다.
# 기존 GEMINI_API_KEY는 자동으로 사용하지 않습니다.
TRANSLATION_GEMINI_API_KEY=""
# 결제 연결이 없는 무료 프로젝트임을 확인한 경우에만 true를 입력합니다.
TRANSLATION_FREE_TIER_CONFIRMED=""
# 기본 모델은 비어 있으면 하루 API 요청 450회(기사 수 아님), 1~500회 설정 가능.
# 한도 도달 시 3.1 Flash Lite(최대 450회), 3.8 Flash·3.6 Flash(각 최대 18회) 순서로 전환합니다.
# 아래 값이 더 작으면 대체 모델에도 적용합니다. 모델별 최소 간격은 5·5·13·13초이며 입력 크기에 따라 늘어납니다.
TRANSLATION_DAILY_REQUEST_LIMIT=""
